# AIT Voice — credentials. Copy to `.env` and fill in.
#
# `.env` is gitignored. Never commit real values, and never paste them into a
# chat session.
#
# You do not need all of these. The pipeline runs with none of them using the
# offline providers; each block below turns on one real vendor leg.

# --- Dialog -----------------------------------------------------------------
# ANTHROPIC_API_KEY=

# --- Speech to text ---------------------------------------------------------
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=

# --- Text to speech ---------------------------------------------------------
# ELEVENLABS_API_KEY=
# CARTESIA_API_KEY=
# RUMIK_API_KEY=          # India region only — no HIPAA posture, never for US PHI

# --- Telephony --------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# EXOTEL_SID=
# EXOTEL_API_KEY=

# --- Database -----------------------------------------------------------------
# Postgres only. See docs/database.md.
#
# TWO ROLES, and the split is load-bearing: a superuser bypasses row-level
# security unconditionally, so the application must NOT connect as `postgres`.
# The app refuses to start if it detects one.
AIT_DB_HOST=localhost
AIT_DB_PORT=5432
AIT_DB_NAME=ait-voice
# The application role — created by the migration, no DDL, not a superuser.
AIT_DB_USER=ait_app
AIT_DB_PASSWORD=local_dev_only
# Owner credentials, used by `ait-voice-migrate` only.
AIT_DB_OWNER_USER=postgres
# AIT_DB_OWNER_PASSWORD=

# --- Local ------------------------------------------------------------------
AIT_LOG_LEVEL=INFO

# Where the audit log and the content store are written. They are separate
# because their retention obligations are opposite: the audit log is retained
# and never erased, the content store is erased when its purpose ends. Keep
# them on separate volumes in a real deployment, not just separate paths.
# AIT_AUDIT_ROOT=var/audit
# AIT_CONTENT_ROOT=var/content
